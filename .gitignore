# ===========================================
# Screenshot Testing (Compose)
# ===========================================

# Ignore generated screenshot outputs
app/build/compose-screenshots/
app/build/screenshot/
app/build/test-results/
app/build/reports/

# ✅ DO commit golden images
# Default location for screenshot plugin golden images
!app/src/screenshotTest/golden/
!app/src/screenshotTest/golden/**

# ✅ If you store snapshot images under test/
# (e.g. app/src/test/snapshots/)
!app/src/test/snapshots/
!app/src/test/snapshots/**

# ===========================================
# Gradle Wrapper
# ===========================================
!gradle/wrapper/gradle-wrapper.jar
!gradlew
!gradlew.bat
